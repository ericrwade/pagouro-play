; Engine configuration file.
; Pagouro Jigsaw: a free jigsaw puzzle of Belle Époque posters drawn by Pagouro BE, with music from Pagouro Salon.

config_version=5

[application]

config/name="Pagouro Jigsaw"
config/version="0.2.4"
config/description="Free jigsaw puzzles of Belle Époque posters drawn by Pagouro BE. Free, thanks to Pagouro."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.937, 0.89, 0.776, 1)
boot_splash/image="res://art/icon/icon_256.png"
boot_splash/fullsize=false
config/icon="res://art/icon/icon_256.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.937, 0.89, 0.776, 1)
